{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spin Tracker OP",
  "version": "0.1.0",
  "identifier": "com.spintrackerop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spin Tracker OP",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0d0b0a"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Spin Tracker OP",
    "category": "Utility",
    "shortDescription": "Tracker open source pour Spin & Go",
    "longDescription": "Spin Tracker OP analyse vos historiques de Spin/Twister/Expresso : CEV, EV profit, bankroll, leak finder, joueurs, replayer et challenges.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
